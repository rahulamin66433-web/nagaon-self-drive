<script>
(function () {
  var CARS = [
    { id: "alto800", name: "Alto 800", price: 999, type: "Hatchback", seats: "5 seats", shape: "hatch" },
    { id: "altok10", name: "Alto K10", price: 1099, type: "Hatchback", seats: "5 seats", shape: "hatch" },
    { id: "wagonr", name: "WagonR", price: 1399, type: "Hatchback", seats: "5 seats", shape: "hatch" },
    { id: "i10", name: "Hyundai i10", price: 1499, type: "Hatchback", seats: "5 seats", shape: "hatch" },
    { id: "swift", name: "Maruti Swift", price: 1499, type: "Hatchback", seats: "5 seats", shape: "hatch" },
    { id: "tiago", name: "Tata Tiago", price: 1499, type: "Hatchback", seats: "5 seats", shape: "hatch" },
    { id: "dzire", name: "Maruti Dzire", price: 1699, type: "Sedan", seats: "5 seats", shape: "sedan" },
    { id: "i20", name: "Hyundai i20", price: 1799, type: "Hatchback", seats: "5 seats", shape: "hatch" },
    { id: "ertiga", name: "Maruti Ertiga", price: 2599, type: "MPV", seats: "7 seats", shape: "mpv" },
    { id: "innova", name: "Toyota Innova", price: 3499, type: "MPV", seats: "7 to 8 seats", shape: "mpv" }
  ];
  var WA = "916000065149";
  var $ = function (id) { return document.getElementById(id); };
  var inr = function (n) { return "₹" + Number(n).toLocaleString("en-IN"); };
  var byId = function (id) { for (var i = 0; i < CARS.length; i++) if (CARS[i].id === id) return CARS[i]; return CARS[0]; };

  /* fleet */
  var list = $("fleet-list"), select = $("car");
  CARS.forEach(function (c) {
    var o = document.createElement("option");
    o.value = c.id; o.textContent = c.name + " (" + inr(c.price) + "/day)";
    select.appendChild(o);
  });
  function renderFleet(filter) {
    list.innerHTML = "";
    CARS.filter(function (c) { return filter === "all" || c.type === filter; }).forEach(function (c) {
      var li = document.createElement("li");
      li.className = "car";
      li.innerHTML =
        '<div class="car-art"><svg viewBox="0 0 240 110" role="img" aria-label="' + c.name + ' silhouette"><use href="#car-' + c.shape + '"/></svg></div>' +
        '<div class="car-body"><div><h3>' + c.name + '</h3><p class="car-meta">' + c.type + " · " + c.seats + '</p></div>' +
        '<div class="car-foot"><span class="plate"><span class="amt">' + inr(c.price) + '</span><span class="per">/day</span></span>' +
        '<button class="btn btn-tea" type="button" data-car="' + c.id + '">Book this car</button></div></div>';
      list.appendChild(li);
    });
  }
  renderFleet("all");
  document.querySelectorAll(".chip").forEach(function (b) {
    b.addEventListener("click", function () {
      document.querySelectorAll(".chip").forEach(function (x) { x.setAttribute("aria-pressed", x === b ? "true" : "false"); });
      renderFleet(b.getAttribute("data-f"));
    });
  });
  list.addEventListener("click", function (e) {
    var t = e.target.closest("button[data-car]");
    if (!t) return;
    select.value = t.getAttribute("data-car");
    update();
    $("book").scrollIntoView({ behavior: "smooth", block: "start" });
    setTimeout(function () { $("name").focus({ preventScroll: true }); }, 400);
  });

  /* dates */
  function iso(d) { var m = d.getMonth() + 1, day = d.getDate(); return d.getFullYear() + "-" + (m < 10 ? "0" : "") + m + "-" + (day < 10 ? "0" : "") + day; }
  var today = new Date(); today.setHours(0, 0, 0, 0);
  var tomorrow = new Date(today); tomorrow.setDate(tomorrow.getDate() + 1);
  var after = new Date(today); after.setDate(after.getDate() + 3);
  $("pickup").min = iso(today); $("ret").min = iso(today);
  $("pickup").value = iso(tomorrow); $("ret").value = iso(after);
  select.value = "swift";
  function parse(v) { return v ? new Date(v + "T00:00:00") : null; }
  function fmt(d) { return d.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" }); }

  function state() {
    var car = byId(select.value), p = parse($("pickup").value), r = parse($("ret").value);
    var days = (p && r) ? Math.max(1, Math.round((r - p) / 86400000)) : 0;
    return { car: car, p: p, r: r, days: days, total: days * car.price };
  }
  function message(s) {
    var lines = ["Hello Nagaon Self Drive, I want to book a car.",
      "Car: " + s.car.name + " (" + inr(s.car.price) + "/day)",
      "Pick up: " + (s.p ? fmt(s.p) : "-") + ", " + ($("ptime").value || "-"),
      "Return: " + (s.r ? fmt(s.r) : "-")];
    if (s.days) lines.push("Estimate: " + s.days + (s.days === 1 ? " day" : " days") + " = " + inr(s.total));
    lines.push("Name: " + ($("name").value.trim() || "-"));
    lines.push("Phone: " + ($("phone").value.trim() || "-"));
    if ($("notes").value.trim()) lines.push("Notes: " + $("notes").value.trim());
    return lines.join("\n");
  }
  function update() {
    var s = state();
    $("q-total").textContent = s.days ? inr(s.total) : "₹0";
    $("q-line").textContent = s.days ? s.days + (s.days === 1 ? " day" : " days") + " × " + inr(s.car.price) : "Choose your dates";
    var m = message(s);
    $("preview").textContent = m;
    $("wa").href = "https://wa.me/" + WA + "?text=" + encodeURIComponent(m);
  }
  function problem() {
    var s = state();
    if (!s.p || !s.r) return "Choose a pick up date and a return date.";
    if (s.r < s.p) return "The return date must be on or after the pick up date.";
    if (s.p < today) return "The pick up date cannot be in the past.";
    if (!$("ptime").value) return "Choose a pick up time.";
    if (!$("name").value.trim()) return "Enter your name.";
    var digits = $("phone").value.replace(/\D/g, "");
    if (digits.length < 10) return "Enter a phone number with at least 10 digits.";
    return "";
  }
  ["car", "pickup", "ptime", "ret", "name", "phone", "notes"].forEach(function (id) {
    $(id).addEventListener("input", function () { $("msg").textContent = ""; $("msg").className = "form-msg"; update(); });
  });
  $("pickup").addEventListener("change", function () {
    var p = parse($("pickup").value), r = parse($("ret").value);
    if (p) { $("ret").min = iso(p); if (!r || r < p) { $("ret").value = $("pickup").value; } }
    update();
  });
  $("wa").addEventListener("click", function (e) {
    var err = problem();
    if (err) { e.preventDefault(); $("msg").className = "form-msg"; $("msg").textContent = err; return; }
    $("msg").className = "form-msg ok";
    $("msg").textContent = "Your booking message is ready in WhatsApp. Press send there to finish.";
  });
  $("book").addEventListener("submit", function (e) { e.preventDefault(); });
  $("copy").addEventListener("click", function () {
    var b = $("copy"), txt = $("preview").textContent;
    function done(t) { b.textContent = t; setTimeout(function () { b.textContent = "Copy message"; }, 2200); }
    try {
      navigator.clipboard.writeText(txt).then(function () { done("Copied"); }, function () { done("Select the text above to copy"); });
    } catch (err) { done("Select the text above to copy"); }
  });
  update();

  /* theme */
  $("theme").addEventListener("click", function () {
    var root = document.documentElement, cur = root.getAttribute("data-theme");
    var dark = cur ? cur === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
    root.setAttribute("data-theme", dark ? "light" : "dark");
  });
})();
</script>

